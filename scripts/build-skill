#!/usr/bin/env node
// Builds every copy of the instructions from BUILD-BRIEF.md, the one source.
//   scripts/build-skill          write the generated files
//   scripts/build-skill --check  fail if any generated file is out of date
import { readFileSync, writeFileSync, mkdirSync, existsSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const source = readFileSync(join(root, "BUILD-BRIEF.md"), "utf8").trimEnd() + "\n";
const notice =
  "<!-- Generated from BUILD-BRIEF.md by scripts/build-skill. Don't edit this file: edit BUILD-BRIEF.md and run the script. -->";

const skillFrontmatter = [
  "---",
  "name: run",
  "description: Build Brief. Interviews a founder one question at a time and turns their idea into a clear brief and step-by-step build prompts. Use when the person asks to run Build Brief, to write requirements, to plan what to build, or to turn an idea into a spec. Proposes priority but leaves the first-version choice to the founder.",
  "allowed-tools: Read, Write",
  "disallowed-tools: Edit, NotebookEdit, Bash, WebSearch, WebFetch",
  "---",
].join("\n");

const startLines = {
  "chat.md":
    "You are in a chat. You can't write files, so send each section in the conversation, one at a time.",
};

const outputs = {
  "plugins/build-brief/skills/run/SKILL.md": `${skillFrontmatter}\n\n${notice}\n\n${source}`,
};
for (const [file, line] of Object.entries(startLines)) {
  outputs[`start/${file}`] = `${line} Run the Build Brief below.\n\n${source}`;
}

// The plugin folder gets its own README for the Claude directory listing,
// copied from README.md with relative links pointed at GitHub.
outputs["plugins/build-brief/README.md"] = readFileSync(join(root, "README.md"), "utf8").replace(
  /\]\((?!https?:|#|mailto:)([^)]+)\)/g,
  "](https://github.com/discovery-to-delivery-katmoo/build-brief/blob/main/$1)",
);

const check = process.argv.includes("--check");
const stale = [];
for (const [rel, content] of Object.entries(outputs)) {
  const path = join(root, rel);
  const current = existsSync(path) ? readFileSync(path, "utf8") : null;
  if (current === content) continue;
  if (check) stale.push(rel);
  else {
    mkdirSync(dirname(path), { recursive: true });
    writeFileSync(path, content);
    console.log(`wrote ${rel}`);
  }
}
if (check) {
  if (stale.length) {
    console.error(`Out of date: ${stale.join(", ")}. Run scripts/build-skill.`);
    process.exit(1);
  }
  console.log("All generated files match BUILD-BRIEF.md.");
}
